# =====================================================================
#  ELK ortam ayarlari. install.sh bu dosyayi .env olarak kopyalar ve
#  "CHANGE_ME" iceren sifreleri rastgele uretilmis degerlerle degistirir.
#  Elle kurulumda:  cp .env.example .env  &&  ./bin/elk.sh init-secrets
# =====================================================================

# Docker compose proje adi (container/volume on eki)
COMPOSE_PROJECT_NAME=elk

# Elastic Stack surumu. Offline pakette bu surumun imajlari bulunur.
# DEGISTIRIRSENIZ yeni imajlari da offline pakete eklemelisiniz.
ELK_VERSION=8.19.25

# Portlarin dinleyecegi host adresi. 0.0.0.0 = tum arayuzler.
# Sadece bu makineden erisim icin 127.0.0.1 yapin.
BIND_ADDRESS=0.0.0.0

# Disariya acilan portlar
ES_PORT=9200
KIBANA_PORT=5601
LOGSTASH_TCP_PORT=5000
LOGSTASH_HTTP_PORT=8080
LOGSTASH_API_PORT=9600

# JVM heap boyutlari (sunucu RAM'inin yarisini gecmeyin)
ES_HEAP=1g
LS_HEAP=512m

# Loglarin Elasticsearch'te tutulacagi gun sayisi (ILM ile otomatik silinir)
LOG_RETENTION_DAYS=30

# ------------------------- SIFRELER ----------------------------------
# 'elastic' super kullanici sifresi (Kibana girisi: elastic / bu sifre)
ELASTIC_PASSWORD=CHANGE_ME
# Kibana'nin ES'ye baglanmak icin kullandigi dahili kullanici
KIBANA_SYSTEM_PASSWORD=CHANGE_ME
# Logstash'in izleme (monitoring) verisi gondermek icin kullandigi dahili kullanici
LOGSTASH_SYSTEM_PASSWORD=CHANGE_ME
# Logstash'in applogs-* index'lerine yazmak icin kullandigi kullanici
LOGSTASH_WRITER_PASSWORD=CHANGE_ME
# Kibana saved-object sifreleme anahtari (en az 32 karakter)
KIBANA_ENCRYPTION_KEY=CHANGE_ME_CHANGE_ME_CHANGE_ME_CHANGE_ME

# Kibana'nin kullanicilara gosterecegi adres (linkler icin)
KIBANA_PUBLIC_URL=http://localhost:5601
